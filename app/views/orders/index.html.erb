<h1>Orders</h1>

<% @orders.each do |order| %>
  <div class="order">
    <div class="order-details">
      <div>
        <p><strong>ID:</strong> <%= order.id %></p>
        <p><strong>Created:</strong> <%= order.created_at.strftime("%B %-d, %Y %H:%M") %></p>
        <p>
          <strong>Promotion Codes:</strong>
          <%= order.promotion_codes.presence&.join(", ") || "-" %>
        </p>
        <p>
          <strong>Discount Codes:</strong>
          <%= order.discount_code.presence || "-" %>
        </p>

        <p class="total-price">
          Total Price: <%= format("%.2f", OrderPriceCalculator.new(order).call) %>€
        </p>

        <%= button_to "Complete",
                      order_path(order),
                      method: :patch %>
      </div>

      <div class="items">
        <strong>Items:</strong>

        <ul>
          <% order.items.each do |item| %>
            <li>
              <%= item["name"] %> (<%= item["size"] %>)

              <% if item["add"].present? %>
                <ul>
                  <li>Add: <%= item["add"].join(", ") %></li>
                </ul>
              <% end %>

              <% if item["remove"].present? %>
                <ul>
                  <li>Remove: <%= item["remove"].join(", ") %></li>
                </ul>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>